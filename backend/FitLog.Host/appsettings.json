{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ApplicationSettings": {
    "PgAutoMigrations": false
  },
  "Authentication": {
    "Oidc": {
      "Authority": "",
      "MetadataAddress": "",
      "Audience": "fitlog-api",
      "RolesClaimPath": "realm_access.roles",
      "RequireHttpsMetadata": true
    }
  }
}
