# Шаблон переменных окружения для docker-compose.yml.
# Скопируйте в `.env` (он в .gitignore) и задайте пароли. Не коммитьте `.env`.
# Подробности: docs/infrastructure.md

# --- PostgreSQL (один контейнер на Keycloak и модули backend) ---
# Суперпользователь: нужен только для init-скрипта и администрирования.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Роль `keycloak`: доступ только к базе `keycloak`.
KEYCLOAK_DB_PASSWORD=

# Роль `fitlog`: доступ к базам модулей backend.
FITLOG_DB_PASSWORD=

# Базы модулей backend через пробел (по базе на модуль, правило «своя БД на модуль»).
# Скрипт init выполняется только на ПУСТОМ volume: новую базу позже создавайте вручную
# или пересоздайте volume (`docker compose down -v`, данные будут потеряны).
FITLOG_MODULE_DBS=fitlog_users

# --- Keycloak ---
# Логин и пароль первого администратора (создаются при первом старте).
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=

# Публичный адрес Keycloak. Он попадает в claim `iss` токенов и должен совпадать
# с Authority backend (Authentication:Oidc:Authority) и EXPO_PUBLIC_OIDC_AUTHORITY.
# Для Android-эмулятора используйте `adb reverse tcp:8080 tcp:8080`, адрес остаётся localhost.
KC_HOSTNAME=http://localhost:8080

# Интерфейс и порт публикации на хосте. Для физического устройства по Wi-Fi:
# KC_BIND=0.0.0.0 и KC_HOSTNAME=http://<LAN IP>:8080.
KC_BIND=127.0.0.1
KC_PORT=8080
